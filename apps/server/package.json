{
  "name": "@spillway/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=../../.env src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "demo": "node --disable-warning=ExperimentalWarning --env-file-if-exists=../../.env src/demo.ts",
    "reset-password": "node --disable-warning=ExperimentalWarning --env-file-if-exists=../../.env src/reset-password.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "openid-client": "^6.8.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
