# Where people open Spillway. Used for SSO redirects and secure cookies.
PUBLIC_URL=http://localhost:8080

# Without these, the first visitor creates the admin account in the browser.
# Used only while nobody exists yet; change the password on the Account page afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Encrypts provider API keys. Generated into the data volume if empty; back it up.
SPILLWAY_SECRET=

# Providers added automatically on the first start (you can also add them in the UI).
OLLAMA_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Seconds a cloud provider may take to start answering before the local model takes over.
UPSTREAM_TIMEOUT_SECONDS=120

# Single sign-on through Google Workspace, Microsoft Entra ID or any OpenID Connect provider.
# Redirect URI to register: <PUBLIC_URL>/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Continue with Google
OIDC_ALLOWED_DOMAINS=
ADMIN_EMAILS=

# Mail server for notification emails (Settings → Notifications). Slack and Teams need nothing here.
# smtp://user:password@smtp.example.com:587 uses STARTTLS, smtps://…:465 TLS from the start.
# Special characters in the password must be URL-encoded, e.g. @ as %40.
SMTP_URL=
SMTP_FROM=

# Server time zone. Budgets and working hours follow the zone picked in Settings; this is only the
# default until someone picks one.
TZ=UTC

# Image version to run (docker compose). latest follows releases; pin one, like 0.3.3, to upgrade on your schedule.
SPILLWAY_TAG=latest

# Port on this machine.
SPILLWAY_PORT=8080
